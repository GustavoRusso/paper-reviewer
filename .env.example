# Local Compose environment (copy to .env before `just up`).
#
# Linux/macOS:  cp .env.example .env
# PowerShell:   Copy-Item .env.example .env
#
# .env is gitignored; never commit real API keys or passwords.
# Compose reads this file for ${VAR} substitution in compose.yml.
#
# Keep POSTGRES_* in sync with DATABASE_URL (same user, password, database).

# --- Postgres (db service) ---
POSTGRES_USER=paper_reviewer
POSTGRES_PASSWORD=paper_reviewer
POSTGRES_DB=paper_reviewer
# Host port mapped to container 5432
POSTGRES_PORT=5432

# In-compose URL (hostname `db`). From the host use localhost:${POSTGRES_PORT}.
DATABASE_URL=postgresql://paper_reviewer:paper_reviewer@db:5432/paper_reviewer

# --- Streamlit UI ---
# Host port mapped to container 8501
UI_PORT=8501

# --- Prefect ---
# In-network API URL for ui / workspace / prefect-worker
PREFECT_API_URL=http://prefect-server:4200/api
# Browser → host Prefect API (must match PREFECT_PORT)
PREFECT_UI_API_URL=http://localhost:4200/api
# Host port mapped to container 4200
PREFECT_PORT=4200

# --- PubMed / NCBI ---
# Optional but recommended for ESearch/EFetch rate limits (~10 req/s vs ~3).
# Obtain a key: https://www.ncbi.nlm.nih.gov/books/NBK25497/
NCBI_API_KEY=

# --- OpenAI (paper briefs) ---
# Used by prefect-worker create_paper_brief. Required for the public OpenAI API.
# Leave empty with OPENAI_BASE_URL set (local OpenAI-compatible gateway).
# Leave both empty to skip live drafts (the job records Failed).
# Do not put this key in Streamlit-only services.
OPENAI_API_KEY=
# Optional OpenAI-compatible API base. Empty = public OpenAI (https://api.openai.com/v1).
# Local gateway on the host, from Compose: http://localhost:11435/v1
# (the worker rewrites localhost to the Docker host).
OPENAI_BASE_URL=
# Chat model id for create_paper_brief. Empty = public API default (gpt-4o-mini).
# Required when OPENAI_BASE_URL is set. Local example:
# OPENAI_MODEL=llama3.1-8b
OPENAI_MODEL=

# --- Jupyter (just notebooks; app stack only, not sandbox) ---
# Host port mapped to container 8888
JUPYTER_PORT=8888
