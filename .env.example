# Local Compose environment (copy to .env before `just up`).
#
# Linux/macOS:  cp .env.example .env
# PowerShell:   Copy-Item .env.example .env
#
# .env is gitignored; never commit real API keys.

# Optional but recommended for PubMed ESearch/EFetch rate limits (~10 req/s vs ~3).
# Obtain a key: https://www.ncbi.nlm.nih.gov/books/NBK25497/
NCBI_API_KEY=
